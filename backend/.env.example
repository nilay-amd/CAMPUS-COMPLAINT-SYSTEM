# CampusCare AI - Environment Configuration Template
# Copy this file to .env and fill in your keys: cp .env.example .env

# =========================================================
# 1. DATABASE SETTINGS (MongoDB with auto SQLite fallback)
# =========================================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=campuscare_db

# =========================================================
# 2. AGENTIC AI PROVIDERS
# =========================================================
# Google AI Studio / Gemini API (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional Providers (Fallback / Multi-model)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =========================================================
# 3. FASTAPI SERVER & SLA SETTINGS
# =========================================================
PORT=8000
HOST=0.0.0.0
# Set to 1.0 for real campus deployment (hours). Set to 0.005 for 2-min demo presentation.
SLA_SCALE=0.01
